# Copy this file to .env and fill in the values. A value that contains # must be quoted. Inside double quotes \n turns
# into a newline, so write Windows paths unquoted, in single quotes or with forward slashes (C:/Users/...).

# F&O environment URL, no trailing slash
FO_URL=https://your-environment.operations.dynamics.com
# Entra tenant where the app registration lives, the directory (tenant) ID
FO_TENANT_ID=00000000-0000-0000-0000-000000000000
# App registration. For the local server (client credentials) no API permissions are needed, the client ID must be
# registered in F&O under System administration > Setup > Microsoft Entra ID applications. The remote server's app needs no
# mapping, but it needs an exposed API with the access_as_user scope and the Dynamics ERP delegated permissions
# AX.FullAccess and Odata.FullAccess with admin consent, see Entra setup in README.
FO_CLIENT_ID=00000000-0000-0000-0000-000000000000
FO_CLIENT_SECRET=your-client-secret
# Default legal entity for company specific entities, reads and writes. USMF is the Contoso demo company, change it to one of
# your legal entities. It is a default and not a limit, Claude can pass company or crossCompany. Leave empty to read all
# companies, writes then need company.
FO_COMPANY=USMF
# Optional. A name for this environment, for example PROD or TEST. Claude sees it in the server instructions and in the
# create_record and update_record descriptions and states it in the confirmation before a write. Empty means the host of
# FO_URL. On the remote server a name set here is also the resource name in the metadata that answers anyone.
FO_NAME=
# Set to 1 to expose create_record and update_record. The local server writes as the F&O user mapped to the client ID,
# the remote server as each signed in user with that user's roles. Leave this at 0 on any environment with real data.
FO_ALLOW_WRITES=0
# Optional. Comma separated collection names Claude may use, for example CustomersV3,SalesOrderHeadersV2.
# Empty means every OData enabled entity the mapped or signed in user can see. environment_info always reads the legal
# entities from LegalEntities and the versions from DataManagementEntities and DocumentRoutingClientApps.
FO_ENTITIES=
# Optional, only with FO_ALLOW_WRITES=1. Comma separated collection names create_record and update_record may use, for example
# CustomerGroups. Empty means every entity the server may read. When FO_ENTITIES is set, each one must be on it too.
FO_WRITE_ENTITIES=
# One JSON line per tool call on stderr with the user, tool, entity, company and result. Writes add the record key, which can
# be personal data such as a personnel number. Never tokens, filters or query results, but F&O error text can name a value.
# 0 turns it off.
FO_AUDIT=1
# Set to 1 to put the written values into the audit lines too, for an update also the old and the new ones.
FO_AUDIT_VALUES=0

# --- Only for the LCS VHD one-box ---
# IP address of the VM when the F&O host name does not resolve on your machine.
FO_HOST_IP=
# PEM file with the self-signed server certificate (relative paths resolve from the project folder).
FO_CA_FILE=
# Last resort instead of FO_CA_FILE: skip all certificate checks for the F&O host. The remote server refuses to start with
# it off localhost unless FO_CA_FILE is set, then FO_CA_FILE wins and the flag has no effect. Never use
# NODE_TLS_REJECT_UNAUTHORIZED=0 instead, it turns the checks off for Entra too. The remote server refuses to start with
# that off localhost whatever else is set.
FO_INSECURE_TLS=0

# --- Rarely needed ---
# Language for labels in describe_entity.
FO_LANGUAGE=en-US
# Time budget in milliseconds for one tool call, shared by every F&O request it makes, 1000 to 60000. MCP clients give up after 60 seconds.
# A create or update is not sent when less than 5 seconds of it are left, or half of it when it is under 10 seconds.
FO_TIMEOUT_MS=50000
# Entra authority for sovereign clouds, for example https://login.microsoftonline.us
FO_AUTHORITY=https://login.microsoftonline.com

# --- Only for the remote server (node dist/http.js), see README ---
# Port to listen on, 1 to 65535.
MCP_PORT=3000
# Address to listen on. Empty means 127.0.0.1 when MCP_PUBLIC_URL is on localhost or 127.0.0.1 and 0.0.0.0 otherwise.
# Any address but localhost, 127.0.0.1 or ::1 needs MCP_PUBLIC_URL set. The Docker image sets 0.0.0.0.
MCP_HOST=
# The URL Claude connects to. Locally http://localhost:<MCP_PORT>/mcp, hosted the public HTTPS URL on a domain of your own,
# for example https://mcp.example.com/mcp. README explains why it should not stay on the generated azurecontainerapps.io name.
# Its origin is also the OAuth issuer, the base of the /callback redirect URI and the origin consent approvals must come from.
# Plain http is refused unless the host is localhost or 127.0.0.1. The MCP SDK refuses an http issuer on [::1].
# Empty means http://localhost:<MCP_PORT>/mcp, which the server accepts only while MCP_HOST keeps it on this machine.
MCP_PUBLIC_URL=
# Audience of the user tokens, api://<FO_CLIENT_ID> unless you gave the app registration a custom Application ID URI.
MCP_AUDIENCE=
# Scope users sign in with, <MCP_AUDIENCE>/access_as_user by default.
MCP_SCOPE=
# Extra host names the server answers for, comma separated, besides the host of MCP_PUBLIC_URL which is always allowed.
# /health answers for any host, so probes on the replica's own address work without it. Needed behind a Front Door or
# Application Gateway that sends the generated azurecontainerapps.io name as the Host header, see Hardening in README.
MCP_ALLOWED_HOSTS=
# App (client) IDs whose own Entra tokens /mcp accepts, comma separated, for scripts such as login-test.mjs. Empty means
# FO_CLIENT_ID while MCP_PUBLIC_URL is on localhost or 127.0.0.1 and no app anywhere else, none turns such tokens off.
# Never list the server's own app on a hosted server, the server warns at start when it does off localhost. Sign ins
# through the server's own OAuth front work either way.
MCP_ALLOWED_CLIENT_APPS=
# Entra app role a user needs for create_record and update_record, for example FO.Write. Empty gives the write tools to every
# signed in user while FO_ALLOW_WRITES=1, which off localhost gives a warning at start. See README for creating and
# assigning the role. A user who gets or loses the role gets a new session with or without the write tools.
MCP_WRITE_ROLE=
# Number of proxies in front of the server that append to X-Forwarded-For, 0 to 10. The limits per address take the client
# address that many entries from the end. Empty means 1, the Container Apps ingress. A WAF or Front Door before it makes 2.
# 0 uses the address of the connection, for a server with nothing in front.
MCP_TRUST_PROXY=
# Key that signs client registrations and remembered approvals and seals sign ins in progress, at least 32 characters, for
# example from openssl rand -base64 32. Empty derives one from FO_CLIENT_SECRET. Changing it, or the secret while it is
# empty, makes every client register again and every browser approve the consent page again, so set it on a hosted
# server before the first user signs in.
MCP_STATE_KEY=

# --- Only for scripts/login-test.mjs ---
# Client ID of a separate test app with Allow public client flows, for the device code sign in. Empty falls back to
# FO_CLIENT_ID, which then needs public client flows itself and works only against a server on localhost or one whose
# MCP_ALLOWED_CLIENT_APPS lists it.
LOGIN_TEST_CLIENT_ID=
