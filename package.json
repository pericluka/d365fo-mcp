{
  "name": "d365fo-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that lets Claude read and write Dynamics 365 Finance and Operations data through OData, locally or as a remote server with Entra sign-in",
  "license": "MIT",
  "author": "Luka Peric",
  "repository": {
    "type": "git",
    "url": "https://github.com/pericluka/d365fo-mcp.git"
  },
  "keywords": [
    "mcp",
    "dynamics-365",
    "finance-and-operations",
    "odata",
    "claude"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "call": "node scripts/call.mjs",
    "start:http": "node dist/http.js",
    "test": "node --test test/*.test.mjs",
    "pretest": "npm run build",
    "eval": "npm run build && node evals/run.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
